// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Autenticazione (tabelle richieste da Better Auth) ───────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // Ultima volta che il sito era aperto: serve per lo stato online/offline
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  memberships     Membership[]
  characters      Character[]
  rolls           Roll[]
  editRequests    EditRequest[]
  invitationsSent Invitation[]
  sessionsStarted GameSession[]
  chatMessages    ChatMessage[]
  journalEntries  JournalEntry[]
  datePolls       DatePoll[]
  dateVotes       DateVote[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Campagne e ruoli ────────────────────────────────────────────

// Il ruolo vale per campagna: si può essere master in una e giocatore in un'altra.
enum Role {
  MASTER
  PLAYER
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Codice da condividere con gli amici per entrare nella campagna
  inviteCode  String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       Membership[]
  characters    Character[]
  rolls         Roll[]
  invitations   Invitation[]
  sessions      GameSession[]
  messages      ChatMessage[]
  journal       JournalEntry[]
  datePolls     DatePoll[]
  // Data della prossima sessione, scelta dal master dal sondaggio
  nextSessionAt DateTime?

  @@map("campaign")
}

model Membership {
  id       String   @id @default(cuid())
  role     Role
  joinedAt DateTime @default(now())
  // Il giocatore ha premuto "Sono pronto" per la prossima sessione
  ready    Boolean  @default(false)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([campaignId])
  @@map("membership")
}

// Invito a una persona precisa, per email (l'account Google con cui accederà).
// Chi entra con il link senza invito diventa membro direttamente.
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Invitation {
  id          String           @id @default(cuid())
  // Sempre in minuscolo, per confrontarla con l'email dell'account
  email       String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([email, status])
  @@map("invitation")
}

// Una serata di gioco: il master la avvia, i giocatori ci entrano, il master la termina.
// Per campagna al massimo una sessione ACTIVE alla volta (controllato dalle azioni).
enum SessionStatus {
  ACTIVE
  ENDED
}

model GameSession {
  id        String        @id @default(cuid())
  status    SessionStatus @default(ACTIVE)
  startedAt DateTime      @default(now())
  endedAt   DateTime?

  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startedById String
  startedBy   User     @relation(fields: [startedById], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("game_session")
}

// Chat della campagna: la vedono e la scrivono solo i membri.
model ChatMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("chat_message")
}

// Diario della campagna. SHARED: lo leggono e scrivono tutti i membri.
// MASTER: note personali del master, le vede solo lui.
enum JournalScope {
  SHARED
  MASTER
}

enum JournalKind {
  SESSION
  NPC
  PLACE
  NOTE
}

model JournalEntry {
  id        String       @id @default(cuid())
  scope     JournalScope
  kind      JournalKind
  title     String
  body      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([campaignId, scope, createdAt])
  @@map("journal_entry")
}

// Sondaggio sulle date della prossima sessione: il master propone, tutti rispondono, il master sceglie.
enum PollStatus {
  OPEN
  CLOSED
}

enum Availability {
  YES
  MAYBE
  NO
}

model DatePoll {
  id        String     @id @default(cuid())
  status    PollStatus @default(OPEN)
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  options     DateOption[]

  @@index([campaignId, status])
  @@map("date_poll")
}

model DateOption {
  id       String   @id @default(cuid())
  startsAt DateTime

  pollId String
  poll   DatePoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  DateVote[]

  @@index([pollId])
  @@map("date_option")
}

model DateVote {
  id     String       @id @default(cuid())
  answer Availability

  optionId String
  option   DateOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@map("date_vote")
}

// ─── Personaggi ──────────────────────────────────────────────────

model Character {
  id        String   @id @default(cuid())
  // Tutta la scheda (caratteristiche, PF, incantesimi, inventario...).
  // La forma è validata con zod in features/characters/schema.ts
  sheet     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Un personaggio può esistere anche fuori da una campagna
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  editRequests EditRequest[]
  rolls        Roll[]

  @@index([ownerId])
  @@index([campaignId])
  @@map("character")
}

// Il master propone una modifica alla scheda, il giocatore la accetta o la rifiuta.
enum EditRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model EditRequest {
  id         String            @id @default(cuid())
  status     EditRequestStatus @default(PENDING)
  // Elenco di modifiche: [{ path, label, from, to }].
  // "from" serve a controllare che il valore non sia cambiato nel frattempo.
  changes    Json
  message    String?
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([characterId, status])
  @@map("edit_request")
}

// ─── Dadi ────────────────────────────────────────────────────────

model Roll {
  id        String   @id @default(cuid())
  label     String // es. "Percezione", "Attacco con Mazza", "Tiro libero"
  notation  String // es. "2d20kh1+7"
  rolls     Int[]
  kept      Int[]
  modifier  Int
  total     Int
  createdAt DateTime @default(now())

  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  campaignId  String?
  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([characterId, createdAt])
  @@map("roll")
}
