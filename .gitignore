# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Environment variables ──────────────────────────────────
# Never commit secrets. Only .env.example is tracked.
.env
.env*
**/.env
**/.env*
!.env.example
!**/.env.example

# ─── Node / Next.js ─────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/
.vercel
.turbo

*.tsbuildinfo
next-env.d.ts

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Prisma generated client
/lib/generated/prisma

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ─── Testing ────────────────────────────────────────────────
coverage/

# ─── OS / Editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── Misc ───────────────────────────────────────────────────
*.pem
*.log

# Immagini caricate in sviluppo (in produzione stanno su Vercel Blob)
/public/uploads
